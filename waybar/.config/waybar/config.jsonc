{
  "position": "top",
  "modules-left": [
	"hyprland/window"
  ],
  "modules-center": [
  	"hyprland/workspaces"
  ],
  "modules-right": [
	 "mpris", 
	 "pulseaudio", 
	 "network", 
	 "bluetooth", 
	 "clock" 
  ],
  "clock": {
    "format": "<span foreground='#f5e0dc'>   </span>{:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#f5e0dc'>  </span>",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>󰤭  </span> Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000' foreground='#f5e0dc'>  </span>Disconnected",
    "tooltip-format-wifi": "{essid} - Signal Strenght: {signalStrength}%"
  },
  "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "pavucontrol"
  },

	"bluetooth": {
	  "format": " {status}",
	  "format-disabled": " off",
	  "format-connected": "",
	  "tooltip": true,
	  "on-click": "blueman-manager",
	  "tooltip-format": "{controller_alias}\n{device_alias}"
	},
	"mpris": {
	  "format": "{player_icon}  {status_icon}  {artist} - {title}",
	  "format-paused": "{player_icon} {status_icon} {artist} - {title}",
	  "format-stopped": "",
	  "player-icons": {
	    "default": "",
	    "spotify": "",
	    "firefox": "",
	    "chromium": ""
	  },
	  "status-icons": {
	    "playing": "",
	    "paused": "",
	    "stopped": ""
	  },
	  "tooltip": true,
	  "tooltip-format": "{player} ({status})\n{dynamic}"
	}
}
